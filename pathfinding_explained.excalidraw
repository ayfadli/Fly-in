   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "id": "t120",
   "type": "text",
   "x": 963,
   "y": 2367.5,
   "width": 436.04,
   "height": 150.0,
   "text": "def _pick_routes(self, routes):\n    kept = []\n    used = set()               # directed edges (a, b)\n    for route in routes:\n        edges = list(zip(route, route[1:]))\n        if any((b, a) in used for a, b in edges):\n            continue           # head-on with a kept route\n        used.update(edges)\n        kept.append(route)\n    return kept or routes[:1]",
   "originalText": "def _pick_routes(self, routes):\n    kept = []\n    used = set()               # directed edges (a, b)\n    for route in routes:\n        edges = list(zip(route, route[1:]))\n        if any((b, a) in used for a, b in edges):\n            continue           # head-on with a kept route\n        used.update(edges)\n        kept.append(route)\n    return kept or routes[:1]",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 11,
   "containerId": null,
