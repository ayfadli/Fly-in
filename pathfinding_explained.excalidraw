   "id": "r134",
   "type": "rectangle",
   "x": 1000,
   "y": 2748.5,
   "width": 436.205,
   "height": 319.875
  },
  {
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1319205689,
   "version": 1,
   "versionNonce": 159214594,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "id": "t135",
   "type": "text",
   "x": 1013,
   "y": 2757.5,
   "width": 418.205,
   "height": 301.875,
   "text": "def plan(self):\n    routes = self._pick_routes(\n        self._yen(_YEN_ROUTES))\n    plan = []\n    for _ in range(self.graph.nb_drones):\n        plan.append(\n            self._best_next_route(plan, routes))\n    return plan\n\ndef _best_next_route(self, plan, routes):\n    best_route, best_arrival = routes[0], None\n    for route in routes:\n        trial = (plan + [route])[-_TRIAL_WINDOW:]\n        try:\n            arrival = Simulation(\n                self.graph, trial).arrival_of_last()\n        except RuntimeError:      # route jams fleet\n            continue\n        if best_arrival is None or arrival < best_arrival:\n            best_route, best_arrival = route, arrival\n    return best_route",
   "originalText": "def plan(self):\n    routes = self._pick_routes(\n        self._yen(_YEN_ROUTES))\n    plan = []\n    for _ in range(self.graph.nb_drones):\n        plan.append(\n            self._best_next_route(plan, routes))\n    return plan\n\ndef _best_next_route(self, plan, routes):\n    best_route, best_arrival = routes[0], None\n    for route in routes:\n        trial = (plan + [route])[-_TRIAL_WINDOW:]\n        try:\n            arrival = Simulation(\n                self.graph, trial).arrival_of_last()\n        except RuntimeError:      # route jams fleet\n            continue\n        if best_arrival is None or arrival < best_arrival:\n            best_route, best_arrival = route, arrival\n    return best_route",
   "fontSize": 11.5,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 10,
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
