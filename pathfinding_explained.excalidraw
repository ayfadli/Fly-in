   "updated": 1700000000000,
   "link": null,
   "locked": false,
   "id": "t152",
   "type": "text",
   "x": 157,
   "y": 3403.375,
   "width": 768.14,
   "height": 225.0,
   "text": "Pathfinder(graph).plan()\n  |\n  |--  _yen(15)\n  |      |--  _dijkstra(start -> end)              the first route\n  |      '--  _dijkstra(spur  -> end)  x many      each with its own bans   ->  up to 15 routes\n  |\n  |--  _pick_routes(...)                           drop head-on routes           ->  safe candidate set\n  |\n  |--  for drone 1 .. nb_drones:\n  |      '--  _best_next_route(plan, routes)\n  |             '--  Simulation(graph, trial).arrival_of_last()   per candidate  ->  keep earliest\n  |\n  '--  returns  list[Route]         plan[i]  is the route for drone  i + 1\n\nthen  src/__main__.py :   Simulation(graph, plan).run()   \u2014 plays it for real and prints the turns",
   "originalText": "Pathfinder(graph).plan()\n  |\n  |--  _yen(15)\n  |      |--  _dijkstra(start -> end)              the first route\n  |      '--  _dijkstra(spur  -> end)  x many      each with its own bans   ->  up to 15 routes\n  |\n  |--  _pick_routes(...)                           drop head-on routes           ->  safe candidate set\n  |\n  |--  for drone 1 .. nb_drones:\n  |      '--  _best_next_route(plan, routes)\n  |             '--  Simulation(graph, trial).arrival_of_last()   per candidate  ->  keep earliest\n  |\n  '--  returns  list[Route]         plan[i]  is the route for drone  i + 1\n\nthen  src/__main__.py :   Simulation(graph, plan).run()   \u2014 plays it for real and prints the turns",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 11,
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  }
 ],
